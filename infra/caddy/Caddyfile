# SITE_ADDRESS
#   로컬: localhost (Caddy 내부 CA로 자동 HTTPS)
#   휴대폰 테스트: "localhost, 192.168.x.x" (PC의 LAN IP)
#   운영: galle.cloud
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# API (SSE 포함. Caddy는 text/event-stream 응답을 버퍼링 없이 즉시 흘려보낸다)
	handle /api/* {
		reverse_proxy api:3000
	}

	# WebRTC 시그널링 (WHIP 송출 / WHEP 시청): /live/{broadcastId}/whip|whep
	# 영상 자체는 Caddy를 거치지 않고 8189(UDP/TCP)로 MediaMTX에 직접 연결된다.
	handle /live/* {
		reverse_proxy mediamtx:8889 {
			# MediaMTX는 인가 실패 시 WWW-Authenticate: Basic을 붙인다. 그대로 두면 브라우저가
			# 아이디·비밀번호 입력 창을 띄우므로 지운다 (화면에서 401을 받아 안내한다)
			header_down -WWW-Authenticate
		}
	}

	# 다시보기 녹화 파일 (#12): recordings 볼륨(읽기 전용)을 정적 서빙한다. file_server가 Range 요청을 처리해 탐색이 된다.
	# 요청마다 api에 "등록된 파일이고 방송이 삭제되지 않았는지"를 묻는다. 204면 내보내고, 아니면 api의 404를 그대로 돌려준다.
	# 그래서 삭제된 방송의 영상, 변환 중인 임시 파일, 미등록 파일은 주소를 알아도 받을 수 없다.
	handle /recordings/* {
		forward_auth api:3000 {
			uri /internal/recordings/authorize
			# 클라이언트가 보낸 같은 이름의 헤더는 덮어쓴다
			header_up X-Internal-Secret {$INTERNAL_SECRET}
		}
		root * /media
		file_server
		# 공유 캐시(CDN 등)에 남지 않게 private: 방송이 삭제되면 새 요청부터 막혀야 한다
		header Cache-Control "private, max-age=3600"
	}

	# React SPA
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# 송출 화면에서 카메라·마이크·화면 공유를 쓰므로 자기 출처에만 허용
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
	}
}

# 운영에서만 의미가 있다: www → 루트 리다이렉트
{$WWW_ADDRESS:www.localhost} {
	redir https://{$SITE_ADDRESS:localhost}{uri} permanent
}
