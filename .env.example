# 이 파일을 .env로 복사해서 사용한다. .env는 저장소에 올리지 않는다.

# Caddy가 응답할 주소
#   로컬: localhost
#   휴대폰 테스트: "localhost, 192.168.0.10"  (PC의 LAN IP를 함께 적는다)
#   운영: galle.cloud
SITE_ADDRESS=localhost
WWW_ADDRESS=www.localhost

# 브라우저가 WebRTC 미디어(8189)를 보낼 주소
#   로컬 PC 단독: 127.0.0.1 / 휴대폰 테스트: PC의 LAN IP / 운영: galle.cloud
MEDIA_PUBLIC_HOST=127.0.0.1

# MediaMTX → api 내부 훅을 검증하는 시크릿 (16자 이상)
#   생성 예: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_SECRET=replace-with-random-string

LOG_LEVEL=info

# 서버에서 pull할 이미지 태그 (기본 latest). 롤백할 때 CI가 붙인 sha 태그로 고정한다. 예) IMAGE_TAG=sha-d1afe4f
# IMAGE_TAG=latest

# 세션 쿠키 Secure 속성 (기본 true). http://localhost 개발은 그대로 동작한다.
# http로 LAN IP에 접속해 테스트할 때만 false로 끈다. 운영에서는 끌 수 없다.
# COOKIE_SECURE=false

# 토스페이먼츠 결제(후원) 키. 비워 두면 후원 버튼에 "결제 설정이 없어 후원을 사용할 수 없습니다"가 표시된다.
#   결제창형 결제(SDK v2)를 쓰므로 "주문서형, 결제창형 연동 키"가 필요하다 (API 개별 연동 키 test_ck_는 동작하지 않는다).
#   발급: https://app.tosspayments.com/signup 가입 → 개발자센터 API 키 메뉴(https://developers.tosspayments.com/my/api-keys)
#         > 주문서형, 결제창형 연동 키의 테스트 클라이언트 키(test_gck_...)와 테스트 시크릿 키(test_gsk_...).
#         테스트 키는 실제로 결제되지 않는다.
#   가입 없이 해 보려면 공식 예제(https://github.com/tosspayments/tosspayments-sample)에 공개된
#   문서용 테스트 키(test_gck_docs_... / test_gsk_docs_...)를 쓸 수 있다.
#   라이브 키(live_...)는 기동 단계에서 거부한다(테스트 결제만). 두 값은 함께 넣거나 함께 비운다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 개발 모드 전용: 결제창 없이 결제를 승인된 것으로 처리한다 (E2E용, 운영에서는 켤 수 없고 토스 키와 함께 쓸 수 없다)
# TOSS_FAKE_PAYMENTS=true

# X-Forwarded-For를 믿을 프록시 주소. compose는 Caddy 고정 IP(10.89.0.10)를 자동으로 넣으므로 설정하지 않는다.
# 개발 모드(npm run dev:api)에서는 비워 둔다 = 소켓 주소를 그대로 클라이언트 IP로 쓴다.
# TRUST_PROXY=
