# 이 파일을 .env로 복사해서 사용한다. .env는 저장소에 올리지 않는다.

# Caddy가 응답할 주소
#   로컬: localhost
#   휴대폰 테스트: "localhost, 192.168.0.10"  (PC의 LAN IP를 함께 적는다)
#   운영: galle.cloud
SITE_ADDRESS=localhost
WWW_ADDRESS=www.localhost

# 브라우저가 WebRTC 미디어(8189)를 보낼 주소
#   로컬 PC 단독: 127.0.0.1 / 휴대폰 테스트: PC의 LAN IP / 운영: galle.cloud
MEDIA_PUBLIC_HOST=127.0.0.1

# MediaMTX → api 내부 훅을 검증하는 시크릿 (16자 이상)
#   생성 예: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_SECRET=replace-with-random-string

LOG_LEVEL=info

# 서버에서 pull할 이미지 태그 (기본 latest). 롤백할 때 CI가 붙인 sha 태그로 고정한다. 예) IMAGE_TAG=sha-d1afe4f
# IMAGE_TAG=latest

# 세션 쿠키 Secure 속성 (기본 true). http://localhost 개발은 그대로 동작한다.
# http로 LAN IP에 접속해 테스트할 때만 false로 끈다. 운영에서는 끌 수 없다.
# COOKIE_SECURE=false

# X-Forwarded-For를 믿을 프록시 주소. compose는 Caddy 고정 IP(10.89.0.10)를 자동으로 넣으므로 설정하지 않는다.
# 개발 모드(npm run dev:api)에서는 비워 둔다 = 소켓 주소를 그대로 클라이언트 IP로 쓴다.
# TRUST_PROXY=
